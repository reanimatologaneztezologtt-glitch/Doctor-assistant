      "specialty": "cardiology",
      "sourceId": "rudski2010",
      "severity": "info",
      "requires": [
        "ivc",
        "ivc_collapse"
      ],
      "when": "ivc <= ivc_high && ivc_collapse > ivc_collapse_low"
    },
    {
      "id": "rap_intermediate",
      "specialty": "cardiology",
      "sourceId": "rudski2010",
      "severity": "info",
      "requires": [
        "ivc",
        "ivc_collapse"
      ],
      "when": "!(ivc <= ivc_high && ivc_collapse > ivc_collapse_low) && !(ivc > ivc_high && ivc_collapse < ivc_collapse_low)"
    },
    {
      "id": "rap_high",
      "specialty": "cardiology",
      "sourceId": "rudski2010",
      "severity": "abnormal",
      "requires": [
        "ivc",
        "ivc_collapse"
      ],
