{
  "note": "Rules for DRAFT conclusions. Sex codes: 1 = male, 2 = female. Cut-offs are named values from data/thresholds.json. Each rule needs approval by a verified doctor of its specialty or an admin.",
  "rules": [
    {
      "id": "lvef_reduced",
      "specialty": "cardiology",
      "sourceId": "ase2015",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "sex"
      ],
      "when": "lvef < if(sex==1, lvef_low_m, lvef_low_f)"
    },
    {
      "id": "lv_concentric_remodeling",
      "specialty": "cardiology",
      "sourceId": "ase2015",
      "severity": "abnormal",
      "requires": [
        "lvmi",
        "rwt",
        "sex"
      ],
      "when": "lvmi <= if(sex==1, lvmi_high_m, lvmi_high_f) && rwt > rwt_high"
    },
    {
      "id": "lv_eccentric_hypertrophy",
      "specialty": "cardiology",
      "sourceId": "ase2015",
      "severity": "abnormal",
      "requires": [
        "lvmi",
        "rwt",
        "sex"
      ],
      "when": "lvmi > if(sex==1, lvmi_high_m, lvmi_high_f) && rwt <= rwt_high"
    },
    {
      "id": "lv_concentric_hypertrophy",
      "specialty": "cardiology",
      "sourceId": "ase2015",
      "severity": "abnormal",
      "requires": [
        "lvmi",
        "rwt",
        "sex"
      ],
      "when": "lvmi > if(sex==1, lvmi_high_m, lvmi_high_f) && rwt > rwt_high"
    },
    {
      "id": "la_enlarged",
      "specialty": "cardiology",
      "sourceId": "ase2015",
      "severity": "abnormal",
      "requires": [
        "lavi"
      ],
      "when": "lavi > lavi_high"
    },
    {
      "id": "dd_preserved_ef_normal",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "info",
      "requires": [
        "lvef",
        "ee_avg",
        "e_sept",
        "e_lat",
        "trv",
        "lavi"
      ],
      "when": "lvef >= dd_ef_cut && ((ee_avg > ee_avg_high) + (e_sept < e_sept_low || e_lat < e_lat_low) + (trv > trv_high) + (lavi > lavi_high)) <= 1"
    },
    {
      "id": "dd_preserved_ef_indeterminate",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "info",
      "requires": [
        "lvef",
        "ee_avg",
        "e_sept",
        "e_lat",
        "trv",
        "lavi"
      ],
      "when": "lvef >= dd_ef_cut && ((ee_avg > ee_avg_high) + (e_sept < e_sept_low || e_lat < e_lat_low) + (trv > trv_high) + (lavi > lavi_high)) == 2"
    },
    {
      "id": "dd_preserved_ef_dysfunction",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "ee_avg",
        "e_sept",
        "e_lat",
        "trv",
        "lavi"
      ],
      "when": "lvef >= dd_ef_cut && ((ee_avg > ee_avg_high) + (e_sept < e_sept_low || e_lat < e_lat_low) + (trv > trv_high) + (lavi > lavi_high)) >= 3"
    },
    {
      "id": "dd_reduced_ef_grade1",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "ea",
        "e_vel"
      ],
      "when": "lvef < dd_ef_cut && ea <= dd_ea_low && e_vel <= dd_e_cut"
    },
    {
      "id": "dd_reduced_ef_grade3",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "ea"
      ],
      "when": "lvef < dd_ef_cut && ea >= dd_ea_high"
    },
    {
      "id": "dd_reduced_ef_grade1_by_criteria",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "ea",
        "e_vel",
        "ee_avg",
        "trv",
        "lavi"
      ],
      "when": "lvef < dd_ef_cut && ((ea <= dd_ea_low && e_vel > dd_e_cut) || (ea > dd_ea_low && ea < dd_ea_high)) && ((ee_avg > ee_avg_high) + (trv > trv_high) + (lavi > lavi_high)) <= 1"
    },
    {
      "id": "dd_reduced_ef_grade2",
      "specialty": "cardiology",
      "sourceId": "ase2016",
      "severity": "abnormal",
      "requires": [
        "lvef",
        "ea",
        "e_vel",
        "ee_avg",
        "trv",
        "lavi"
      ],
      "when": "lvef < dd_ef_cut && ((ea <= dd_ea_low && e_vel > dd_e_cut) || (ea > dd_ea_low && ea < dd_ea_high)) && ((ee_avg > ee_avg_high) + (trv > trv_high) + (lavi > lavi_high)) >= 2"
    },
    {
