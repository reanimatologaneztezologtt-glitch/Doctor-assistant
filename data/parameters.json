{
  "note": "Reference values for adults. Sex codes: 1 = male, 2 = female. Every norm cites its source id from data/sources.json.",
  "sections": [
    {
      "id": "general",
      "parameters": [
        { "id": "sex", "type": "select", "options": [1, 2], "unit": null, "sourceId": "ase2015", "diagram": null },
        { "id": "height", "unit": "cm_body", "min": 50, "max": 250, "sourceId": "mosteller1987", "diagram": null },
        { "id": "weight", "unit": "kg", "min": 2, "max": 300, "sourceId": "mosteller1987", "diagram": null },
        { "id": "bsa", "unit": "m2", "derive": "sqrt(height*weight/3600)", "decimals": 2, "sourceId": "mosteller1987", "diagram": null }
      ]
    },
    {
      "id": "chambers",
      "parameters": [
        { "id": "lvedd", "unit": "mm", "min": 20, "max": 100, "decimals": 1, "sourceId": "ase2015", "diagram": "plax", "calculator": "ef-teichholz",
          "norms": [ { "sex": 1, "low": 42.0, "high": 58.4 }, { "sex": 2, "low": 37.8, "high": 52.2 } ] },
        { "id": "lvesd", "unit": "mm", "min": 10, "max": 90, "decimals": 1, "sourceId": "ase2015", "diagram": "plax", "calculator": "ef-teichholz",
          "norms": [ { "sex": 1, "low": 25.0, "high": 39.8 }, { "sex": 2, "low": 21.6, "high": 34.8 } ] },
        { "id": "lvedv", "unit": "ml", "min": 10, "max": 600, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c", "calculator": "ef-simpson",
          "norms": [ { "sex": 1, "low": 62, "high": 150 }, { "sex": 2, "low": 46, "high": 106 } ] },
        { "id": "lvesv", "unit": "ml", "min": 5, "max": 500, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c", "calculator": "ef-simpson",
          "norms": [ { "sex": 1, "low": 21, "high": 61 }, { "sex": 2, "low": 14, "high": 42 } ] },
        { "id": "lvedvi", "unit": "mlm2", "derive": "lvedv/bsa", "decimals": 0, "sourceId": "ase2015", "diagram": "a4c",
          "norms": [ { "sex": 1, "low": 34, "high": 74 }, { "sex": 2, "low": 29, "high": 61 } ] },
        { "id": "lvesvi", "unit": "mlm2", "derive": "lvesv/bsa", "decimals": 0, "sourceId": "ase2015", "diagram": "a4c",
          "norms": [ { "sex": 1, "low": 11, "high": 31 }, { "sex": 2, "low": 8, "high": 24 } ] },
        { "id": "lvef", "unit": "pct", "min": 5, "max": 90, "decimals": 0, "derive": "(lvedv-lvesv)/lvedv*100", "sourceId": "ase2015", "diagram": "a4c", "calculator": "ef-simpson",
          "norms": [ { "sex": 1, "low": 52, "high": 72 }, { "sex": 2, "low": 54, "high": 74 } ] },
        { "id": "lav", "unit": "ml", "min": 5, "max": 400, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c" },
        { "id": "lavi", "unit": "mlm2", "derive": "lav/bsa", "min": 5, "max": 200, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c",
          "norms": [ { "high": 34 } ] }
      ]
    },
    {
      "id": "walls",
      "parameters": [
        { "id": "ivsd", "unit": "mm", "min": 3, "max": 40, "decimals": 1, "sourceId": "ase2015", "diagram": "plax", "calculator": "lvmass-rwt",
          "norms": [ { "sex": 1, "low": 6, "high": 10 }, { "sex": 2, "low": 6, "high": 9 } ] },
        { "id": "pwd", "unit": "mm", "min": 3, "max": 40, "decimals": 1, "sourceId": "ase2015", "diagram": "plax", "calculator": "lvmass-rwt",
          "norms": [ { "sex": 1, "low": 6, "high": 10 }, { "sex": 2, "low": 6, "high": 9 } ] },
        { "id": "lvmass", "unit": "g", "derive": "0.8*1.04*(((ivsd+lvedd+pwd)/10)^3-(lvedd/10)^3)+0.6", "decimals": 0, "sourceId": "ase2015", "diagram": "plax", "calculator": "lvmass-rwt",
          "norms": [ { "sex": 1, "low": 88, "high": 224 }, { "sex": 2, "low": 67, "high": 162 } ] },
        { "id": "lvmi", "unit": "gm2", "derive": "lvmass/bsa", "min": 20, "max": 400, "decimals": 0, "sourceId": "ase2015", "diagram": "plax", "calculator": "lvmass-rwt",
          "norms": [ { "sex": 1, "low": 49, "high": 115 }, { "sex": 2, "low": 43, "high": 95 } ] },
        { "id": "rwt", "unit": "ratio", "derive": "2*pwd/lvedd", "min": 0.1, "max": 1.5, "decimals": 2, "sourceId": "ase2015", "diagram": "plax", "calculator": "lvmass-rwt",
          "norms": [ { "high": 0.42 } ] }
      ]
    },
    {
      "id": "valves",
      "parameters": [
        { "id": "e_vel", "unit": "cms", "min": 10, "max": 250, "decimals": 0, "sourceId": "ase2016", "diagram": "mitral", "calculator": "diastolic" },
        { "id": "a_vel", "unit": "cms", "min": 10, "max": 250, "decimals": 0, "sourceId": "ase2016", "diagram": "mitral", "calculator": "diastolic" },
        { "id": "ea", "unit": "ratio", "derive": "e_vel/a_vel", "min": 0.1, "max": 6, "decimals": 2, "sourceId": "ase2016", "diagram": "mitral", "calculator": "diastolic" },
        { "id": "e_sept", "unit": "cms", "min": 1, "max": 30, "decimals": 1, "sourceId": "ase2016", "diagram": "tdi", "calculator": "diastolic",
          "norms": [ { "low": 7 } ] },
        { "id": "e_lat", "unit": "cms", "min": 1, "max": 30, "decimals": 1, "sourceId": "ase2016", "diagram": "tdi", "calculator": "diastolic",
          "norms": [ { "low": 10 } ] },
        { "id": "ee_avg", "unit": "ratio", "derive": "e_vel/((e_sept+e_lat)/2)", "min": 1, "max": 50, "decimals": 1, "sourceId": "ase2016", "diagram": "tdi", "calculator": "diastolic",
          "norms": [ { "high": 14 } ] },
        { "id": "av_vmax", "unit": "ms", "min": 0.5, "max": 7, "decimals": 1, "sourceId": "ase2017as", "diagram": "cw",
          "norms": [ { "high": 2.5 } ] }
      ]
    },
    {
      "id": "hemodynamics",
      "parameters": [
        { "id": "trv", "unit": "ms", "min": 0.5, "max": 7, "decimals": 1, "sourceId": "esc2022ph", "diagram": "cw", "calculator": "pasp",
          "norms": [ { "high": 2.8 } ] },
        { "id": "rap", "unit": "mmhg", "derive": "if(ivc<=21, if(ivc_collapse>50, 3, 8), if(ivc_collapse<50, 15, 8))", "min": 0, "max": 30, "decimals": 0, "sourceId": "rudski2010", "diagram": "ivc", "calculator": "rap-ivc" },
        { "id": "pasp", "unit": "mmhg", "derive": "4*trv^2+rap", "min": 5, "max": 150, "decimals": 0, "sourceId": "rudski2010", "diagram": "cw", "calculator": "pasp" }
      ]
    },
    {
      "id": "right_heart",
      "parameters": [
        { "id": "rv_basal", "unit": "mm", "min": 10, "max": 80, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c",
          "norms": [ { "high": 41 } ] },
        { "id": "tapse", "unit": "mm", "min": 3, "max": 40, "decimals": 0, "sourceId": "ase2015", "diagram": "mmode",
          "norms": [ { "low": 17 } ] },
        { "id": "rv_sprime", "unit": "cms", "min": 2, "max": 30, "decimals": 1, "sourceId": "ase2015", "diagram": "tdi",
          "norms": [ { "low": 9.5 } ] },
        { "id": "rv_fac", "unit": "pct", "min": 5, "max": 80, "decimals": 0, "sourceId": "ase2015", "diagram": "a4c",
          "norms": [ { "low": 35 } ] },
        { "id": "ivc", "unit": "mm", "min": 3, "max": 50, "decimals": 0, "sourceId": "rudski2010", "diagram": "ivc", "calculator": "rap-ivc",
          "norms": [ { "high": 21 } ] },
        { "id": "ivc_collapse", "unit": "pct", "min": 0, "max": 100, "decimals": 0, "sourceId": "rudski2010", "diagram": "ivc", "calculator": "rap-ivc",
          "norms": [ { "low": 50, "lowExclusive": true } ] }
      ]
    },
    {
      "id": "pericardium",
      "parameters": [
        { "id": "peri", "unit": "mm", "min": 0, "max": 60, "decimals": 0, "sourceId": "esc2015peri", "diagram": "peri" }
      ]
    },
    {
      "id": "aorta_pa",
      "parameters": [
        { "id": "ao_root", "unit": "mm", "min": 10, "max": 80, "decimals": 0, "sourceId": "ase2015", "diagram": "plax" },
        { "id": "pa_diam", "unit": "mm", "min": 10, "max": 60, "decimals": 0, "sourceId": "esc2015ph", "diagram": "psax",
